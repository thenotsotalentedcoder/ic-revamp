# Copy to .env.local and fill in. Never commit .env.local.

# Postgres (Supabase). DATABASE_URL = pooled connection, DIRECT_URL = direct connection (used by Prisma migrations).
DATABASE_URL=
DIRECT_URL=

# Supabase Storage. SERVICE_KEY bypasses all security rules: server-side only, never NEXT_PUBLIC_.
SUPABASE_URL=
SUPABASE_SERVICE_KEY=
SUPABASE_PUBLIC_BUCKET=public-assets

# Signs admin session cookies. At least 32 random characters, e.g.: node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=
